                                              <style type="text/css">
        .abb-widget-box-border {
            border: 1px solid #d5d9d9;
            border-radius: 8px;
        }

        .abb-widget-box-border .a-box-inner {
            background-color: #F7FEFF;
        }

        .prime-logo img {
            max-width: 50px;
            width: 100%;
            height: auto;
        }

        .prime-signup-button {
            background: none;
            border: none;
            padding: 0;
            margin: 0;
            color: #0066c0;
            text-decoration: none;
            cursor: pointer;
            display: inline;
            font-size: 14px;
            font-family: inherit;
        }
        #prime-abb-signup-button:hover {
            color: #c45500;
            text-decoration: underline;
        }
        #prime-abb-signup-button:visited {
            color: #0066c0;
        }
        #prime-abb-signup-button:focus {
            outline: 2px solid #0066c0;
            outline-offset: 2px;
        }
    </style>

    <!-- WLP URL -->
    <script defer src="https://d2ygma30gaykut.cloudfront.net/SFXInjectableScript.js"></script>

    <!-- ABB widget -->
    <div id="abb-widget-section" class="a-section a-spacing-base"> <div class="a-box abb-widget-box-border"><div class="a-box-inner"> <div class="a-section a-spacing-small a-text-left prime-logo"> <img alt="Amazon Prime Logo" src="https://m.media-amazon.com/images/G/31/marketing/prime/2022PrimeBrand/Logos/Prime_Logo_RGB_Prime_Blue_MASTER._CB542734830_.png" class="a-dynamic-image" data-a-dynamic-image="{}"/> </div> <div id="abb-message" class="a-section a-spacing-none a-text-left"> <span> Enjoy <strong>Unlimited FREE Same day/1-day delivery</strong>, Prime offers everyday and more </span> </div> <div id="prime-abb-cta" class="a-section a-spacing-none a-spacing-top-base"> <a id="prime-abb-signup-button" class="a-link-normal prime-signup-button" href="#" role="button"> <strong>Join Prime >></strong> </a> </div> <script type="text/javascript">(function(f) {var _np=(window.P._namespace("PrimeABB"));if(_np.guardFatal){_np.guardFatal(f)(_np);}else{f(_np);}}(function(P) {
                const wlpParams = {
                    clientId: "PrimeAcquisition",
                    ingressId: "DetailPage",
                    redirectURL: "L2RwL2dsYW5jZS9CMERLSktHOVY1P2NsaWVudElkPVByaW1lQWNxdWlzaXRpb24maW5ncmVzc0lkPURldGFpbFBhZ2U=",
                    primeCampaignId: "detailPagePrimeUpsell"
                }

                
                    wlpParams.errorRedirectURL = "L2RwL2dsYW5jZS9CMERLSktHOVY1P2NsaWVudElkPVByaW1lQWNxdWlzaXRpb24maW5ncmVzc0lkPURldGFpbFBhZ2U=";
                

                P.when("sfx-injectable").execute("attach-wlp-signup", async (injectableAPI) => {
                    try {
                        // Get the specific WLP experience that is determined through wlpParams
                        let experienceUUID = injectableAPI.initiate(wlpParams, {});

                        // Add onclick event listener to display WLP widget when customer clicks the ABB CTA
                        const abbSignupCta = document.getElementById("prime-abb-signup-button");
                        abbSignupCta.onclick = () => {
                            injectableAPI.show(experienceUUID);
                        }

                        // Handle SPACE key event for ABB CTA
                        if (abbSignupCta) {
                            abbSignupCta.addEventListener('keydown', (event) => {
                                if (event.keyCode === 32 || event.key === ' ') {
                                    event.preventDefault();
                                    abbSignupCta.click();
                                }
                            });
                        }

                        // In the case of a sign-in redirect, check URL "loadInjectable" query param for match with
                        // clientId + ingressId. If matching, display WLP popup. This is to match previous injectable
                        // behavior whereby when customer signs in from WLP, the popup would be displayed upon redirect
                        //
                        // Query param structure: loadInjectable=[clientId]_[ingressId]
                        const queryString = window.location.search;
                        const queryParams = new URLSearchParams(queryString);
                        const loadInjectableIds = queryParams.get("loadInjectable");
                        if (loadInjectableIds && loadInjectableIds.includes('_')) {
                            const [redirectClientId, redirectIngressId] = loadInjectableIds.split("_");
                            if (redirectClientId === wlpParams.clientId && redirectIngressId === wlpParams.ingressId) {
                                injectableAPI.show(experienceUUID);
                            }
                        }
                    } catch (error) {
                        console.error('PrimeABB error invoking WLP:', error);
                    }
                })
            }));</script> </div></div> </div>                          </div>
